# ==============================================================================
#  TK 素材工坊 · .gitattributes
#  统一换行符处理，避免 Windows / macOS / Linux 之间产生无意义的整文件 diff。
# ==============================================================================

# 默认：由 Git 自动判断文本与二进制；文本入库存 LF
* text=auto

# ---------------------------------------------------------------- 二进制：绝不转换
*.exe     binary
*.dll     binary
*.ico     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.zip     binary
*.7z      binary
*.db      binary
*.db-wal  binary
*.pth     binary
*.onnx    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary

# ---------------------------------------------------------------- 天然使用 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ---------------------------------------------------------------- 源码与文档
*.py      text
*.js      text
*.css     text
*.html    text
*.json    text
*.md      text
*.txt     text
*.yml     text
*.yaml    text
*.toml    text
*.cfg     text
*.cs      text
*.csproj  text
*.gitignore text

# ---------------------------------------------------------------- GitHub 语言统计
# 这两个是脚本生成的，不该算进仓库语言占比。
CHANGELOG.md              linguist-generated
docs/RELEASE-MANIFEST.md  linguist-generated
docs/CHANGELOG.md         linguist-generated
docs/screenshots/**       linguist-vendored
